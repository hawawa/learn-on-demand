{% test average_dollars_spent_greater_than_one(model, column_name, measure_column, min_avg=1) %}

select
    {{ column_name }} as group_key,
    avg({{ measure_column }}) as average_amount
from {{ model }}
group by 1
having count({{ column_name }}) > 1 
   and avg({{ measure_column }}) < {{ min_avg }}

{% endtest %}